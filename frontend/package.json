{
  "name": "ai-test-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:contracts": "node --import tsx tests/contracts.test.ts",
    "test:e2e": "playwright test",
    "test:submissions": "node --import tsx tests/command-journal.test.ts",
    "test:handover": "node --import tsx tests/handover-schema.test.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "tsx": "4.20.6",
    "canonicalize": "2.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "@playwright/test": "1.56.1"
  }
}
